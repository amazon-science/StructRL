+# Action group order (RLDX-1 robocasa365 config action modality_keys).
+_ACTION_GROUP_ORDER = [
+    "end_effector_position",   # 3
+    "end_effector_rotation",   # 3 (axis_angle)
+    "gripper_close",           # 1
+    "base_motion",             # 4
+    "control_mode",            # 1
