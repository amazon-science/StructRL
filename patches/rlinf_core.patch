+#!/usr/bin/env python
+"""Offline verifier for the done-shift credit-assignment fix.
+
+Replays the EXACT per-chunk latch logic from env_worker.py through the REAL
+GAE (rlinf.algorithms) + compute_loss_mask, with envs that succeed at
+DIFFERENT, caller-chosen chunks (proves nothing is hardcoded to 75). Confirms,
+per env:
+  (1) reward propagates backward to chunk 0 (return > 0 before success)
+  (2) success chunk gets full credit
+  (3) post-success garbage reward stays isolated in its own chunk
+  (4) loss_mask keeps 0..success, drops success+1..end
+Run:  .venv-rlinf/bin/python RLinf/tools/verify_done_shift.py --chunks 120 43 7
+"""
+import argparse
+import sys
+
+import torch
+
+sys.path.insert(0, str(__import__("pathlib").Path(__file__).resolve().parents[1]))
+from rlinf.algorithms.advantages import compute_gae_advantages_and_returns
+from rlinf.algorithms.utils import preprocess_embodied_advantages_inputs
+from rlinf.utils.metric_utils import compute_loss_mask
+
+
+def replay(success_chunks, mode, NC=182, CS=16, gamma=0.99, lam=0.95,
+           garbage_after=5, garbage_val=9.0, timing_per_step=0.02,
+           outcome=2.0, done_shift=True):
+    BSZ = len(success_chunks)
+    latch = torch.zeros(BSZ, dtype=torch.bool)
+    terms, truncs, rews = [], [], []
+    for c in range(NC):
+        rew = torch.zeros(BSZ, CS)
+        raw_succ = torch.zeros(BSZ, dtype=torch.bool)
+        for e, sc in enumerate(success_chunks):
+            if c >= sc:
+                raw_succ[e] = True  # sticky success
+            if mode == "timing":
+                if c <= sc:
+                    rew[e, :] = timing_per_step
+                if c == sc:
+                    rew[e, -1] += outcome
+            else:  # sparse 0/1 (use_rel_reward): +1 only at first success step
+                if c == sc:
+                    rew[e, 0] = 1.0
+            if c == sc + garbage_after:
+                rew[e, 0] += garbage_val
+        trunc_now = torch.tensor([c == NC - 1] * BSZ)
+        if done_shift:
+            first_success = raw_succ & (~latch)
+            shifted = latch.clone()
+            latch = latch | first_success
+            if trunc_now.any():
+                latch = latch & (~trunc_now)
+            term = shifted.view(BSZ, 1).expand(BSZ, CS).clone()
+        else:
+            term = raw_succ.view(BSZ, 1).expand(BSZ, CS).clone()
+        trunc = torch.zeros(BSZ, CS, dtype=torch.bool)
+        trunc[:, -1] = trunc_now
+        terms.append(term)
+        truncs.append(trunc)
+        rews.append(rew)
+
+    term = torch.stack(terms, 0)
+    trunc = torch.stack(truncs, 0)
+    rews = torch.stack(rews, 0)
+    dones = term | trunc
+    dones_p1 = torch.cat([dones, dones[-1:].clone()], 0)
+    values = torch.zeros(NC + 1, BSZ, 1)
+    kw = preprocess_embodied_advantages_inputs(
+        rewards=rews, dones=dones_p1, values=values,
+        reward_type="chunk_level", adv_type="gae")
+    adv, ret = compute_gae_advantages_and_returns(
+        rewards=kw["rewards"], values=kw["values"], dones=kw["dones"],
+        gamma=gamma, gae_lambda=lam, normalize_advantages=False)
+    lm, _ = compute_loss_mask(dones_p1)
+    return ret, lm.any(dim=-1)
+
+
+def check(success_chunks, mode, done_shift=True):
+    ret, lm = replay(success_chunks, mode, done_shift=done_shift)
+    print(f"\n{'=' * 64}\nmode={mode}  done_shift={done_shift}  "
+          f"success_chunks={success_chunks}")
+    allok = True
+    for e, sc in enumerate(success_chunks):
+        r0 = ret[0, e].item()
+        rsucc = ret[sc, e].item()
+        rgar = ret[sc + 5, e].item() if sc + 5 < ret.shape[0] else None
+        lm_pre = bool(lm[max(sc - 1, 0), e])
+        lm_post = bool(lm[sc + 1, e]) if sc + 1 < lm.shape[0] else None
+        c1 = r0 > 1e-4
+        c2 = rsucc > 0
+        c3 = (abs(rgar - 9.0) < 1e-3) if rgar is not None else True
+        c4 = lm_pre and (lm_post is False)
+        ok = c1 and c2 and c3 and c4
+        allok &= ok
+        print(f"  env{e} succ@{sc:3d}: ret[0]={r0:+.4f} ret[succ]={rsucc:+.4f} "
+              f"ret[garbage@succ+5]={None if rgar is None else round(rgar, 3)} "
+              f"lm[pre]={lm_pre} lm[post]={lm_post}  -> {'OK' if ok else 'FAIL'}")
+    print(f"  RESULT: {'ALL OK' if allok else 'FAIL'}")
+    return allok
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--chunks", type=int, nargs="+", default=[120, 43, 7])
+    args = ap.parse_args()
+    ok = True
+    check(args.chunks, "sparse", done_shift=False)  # CURRENT broken behavior
+    ok &= check(args.chunks, "sparse", done_shift=True)
+    ok &= check(args.chunks, "timing", done_shift=True)
+    print(f"\n{'#' * 64}\nOVERALL: {'PASS' if ok else 'FAIL'}\n{'#' * 64}")
+    sys.exit(0 if ok else 1)
