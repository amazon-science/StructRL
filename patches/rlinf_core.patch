+#!/usr/bin/env python3
+"""Add rotation_type fields to a LeRobot modality.json so PandaOmronDataConfig
+loads cleanly. The official RC365 SFT pipeline assumes these fields are
+present; our HF-downloaded datasets are missing them.
+
+Mapping (from PandaOmronDataConfig.state_target_rotations + size convention):
+  state.end_effector_rotation_relative  4-dim -> quaternion
+  state.base_rotation                   4-dim -> quaternion
+  action.end_effector_rotation          3-dim -> axis_angle
+
+Run:
+  python patch_modality_rotation.py /path/to/lerobot/meta/modality.json
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+
+ROTATION_TYPE_MAP = {
+    ("state", "base_rotation"): "quaternion",
+    ("state", "end_effector_rotation_relative"): "quaternion",
+    ("action", "end_effector_rotation"): "axis_angle",
+}
+
+
+def patch(path: Path) -> bool:
+    data = json.loads(path.read_text())
+    changed = False
+    for (modality, key), rotation_type in ROTATION_TYPE_MAP.items():
+        block = data.get(modality, {}).get(key)
+        if block is None:
+            continue
+        if block.get("rotation_type") != rotation_type:
+            block["rotation_type"] = rotation_type
+            changed = True
+    if changed:
+        path.write_text(json.dumps(data, indent=4))
+        print(f"[patched] {path}")
+    else:
+        print(f"[unchanged] {path}")
+    return changed
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("paths", nargs="+", help="Paths to modality.json files (or dirs containing them)")
+    args = ap.parse_args()
+    for p in args.paths:
+        path = Path(p)
+        if path.is_dir():
+            target = path / "modality.json"
+            if not target.exists():
+                target = path / "meta" / "modality.json"
+        else:
+            target = path
+        if not target.exists():
+            print(f"[skip] {target} not found")
+            continue
+        patch(target)
+
+
+if __name__ == "__main__":
+    main()
