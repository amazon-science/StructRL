     "libero": convert_to_libero_action,
     "maniskill": convert_to_maniskill_action,
     "isaaclab_stack_cube": convert_to_isaaclab_stack_cube_action,
+    "robocasa365": convert_to_robocasa365_action,
 }
 
 
