+def flatten_rldx_action(action_group_dict, chunk_size: int = 16) -> np.ndarray:
+    """RLDX-1 decode_action group dict -> flat 12-D RoboCasa365 action.
+
+    action_group_dict: {group_key: np.ndarray [B, horizon, dim]} already
+    unnormalized by processor.decode_action. RoboCasa365Env.step re-splits the
+    flat 12-D array into the dict GrootRoboCasaEnv expects.
+    """
+    components = [
+        action_group_dict[k][:, :chunk_size] for k in _ACTION_GROUP_ORDER
+    ]
+    action_array = np.concatenate(components, axis=-1)
+    assert action_array.shape[-1] == 12, (
+        f"Expected 12-dim RoboCasa365 action, got {action_array.shape[-1]}"
+    )
+    return action_array
