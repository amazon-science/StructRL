+def convert_robocasa365_obs_to_gr00t_format(env_obs):
+    """Convert the RLinf flat obs contract into GR00T modality keys for the
+    RoboCasa365 PandaOmron checkpoint (embodiment_tag=new_embodiment).
+
+    The env wrapper (RoboCasa365Env._wrap_obs) emits:
+        states            : [B, 16]  raw, SFT state_keys order:
+                            eef_pos_rel(3), eef_rot_rel(4 quat), gripper_qpos(2),
+                            base_pos(3), base_rot(4 quat)
+        main_images       : [B, 256, 256, 3]  robot0_agentview_left  (already vflip+resized)
+        extra_view_images : [B, 256, 256, 3]  robot0_agentview_right
+        wrist_images      : [B, 256, 256, 3]  robot0_eye_in_hand
+        task_descriptions : list[str]
+
+    Quaternion -> rotation_6d conversion is handled downstream by the
+    StateActionTransform configured in RobocasaPandaOmronDataConfig, so here we
+    only split the raw 16-D state into the named keys.
+    """
+    groot_obs = {}
+
+    # [B, H, W, C] -> [B, T(1), H, W, C]
+    groot_obs["video.robot0_agentview_left"] = (
+        env_obs["main_images"].unsqueeze(1).numpy()
+    )
+    groot_obs["video.robot0_agentview_right"] = (
+        env_obs["extra_view_images"].unsqueeze(1).numpy()
+    )
+    groot_obs["video.robot0_eye_in_hand"] = (
+        env_obs["wrist_images"].unsqueeze(1).numpy()
+    )
+
+    states = env_obs["states"].unsqueeze(1)  # [B, T(1), 16]
+    groot_obs["state.end_effector_position_relative"] = states[:, :, 0:3].numpy()
+    groot_obs["state.end_effector_rotation_relative"] = states[:, :, 3:7].numpy()
+    groot_obs["state.gripper_qpos"] = states[:, :, 7:9].numpy()
+    groot_obs["state.base_position"] = states[:, :, 9:12].numpy()
+    groot_obs["state.base_rotation"] = states[:, :, 12:16].numpy()
+
+    # SFT tokenized each task description as a Python list literal (e.g.
+    # "['Pick the kettle ...']"), because GR00T's batched transform splits a
+    # (B, 1) annotation array into a (1,) per-env value that str()-renders with
+    # brackets. Wrap each string in its own list so the prompt matches training;
+    # a bare (B,) array would render as a bracket-less string the model never
+    # saw, silently degrading the policy.
+    groot_obs["annotation.human.action.task_description"] = [
+        [desc] for desc in env_obs["task_descriptions"]
+    ]
+    return groot_obs
+
+
+def convert_to_robocasa365_action(
+    action_chunk: dict[str, np.array], chunk_size: int = 16
+) -> np.ndarray:
+    """Convert a GR00T action chunk dict into the flat 12-D RoboCasa365 action.
+
+    Layout (matches SFT action_keys order; RoboCasa365Env.step splits it back
+    into the dict GrootRoboCasaEnv expects):
+        [0:3]  action.end_effector_position
+        [3:6]  action.end_effector_rotation  (axis_angle)
+        [6:7]  action.gripper_close          (binary, already in {0,1} after unnorm)
+        [7:11] action.base_motion            (base xyz + torso)
+        [11:12] action.control_mode          (binary)
+
+    Do NOT call normalize_gripper_action here: gripper_close / control_mode use
+    `binary` normalization in the data config, so the GR00T output is already in
+    the env's expected convention.
+    """
+    action_components = [
+        action_chunk["action.end_effector_position"][:, :chunk_size],
+        action_chunk["action.end_effector_rotation"][:, :chunk_size],
+        action_chunk["action.gripper_close"][:, :chunk_size],
+        action_chunk["action.base_motion"][:, :chunk_size],
+        action_chunk["action.control_mode"][:, :chunk_size],
+    ]
+    action_array = np.concatenate(action_components, axis=-1)
+    assert action_array.shape[-1] == 12, (
+        f"Expected 12-dim action, got {action_array.shape[-1]}"
+    )
+    return action_array
+
+
 # TODO: we need a unified embodiement data.
 OBS_CONVERSION = {
     "maniskill": convert_maniskill_obs_to_gr00t_format,
     "libero": convert_libero_obs_to_gr00t_format,
     "isaaclab_stack_cube": convert_libero_obs_to_gr00t_format,
+    "robocasa365": convert_robocasa365_obs_to_gr00t_format,
 }
 
