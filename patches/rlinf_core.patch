+    nested = {
+        "video": {
+            "robot0_agentview_left": _video("main_images", "stacked_main_images"),
+            "robot0_agentview_right": _video("extra_view_images", "stacked_extra_view_images"),
+            "robot0_eye_in_hand": _video("wrist_images", "stacked_wrist_images"),
+        },
+        "state": {
+            "end_effector_position_relative": states[:, :, 0:3].numpy(),
+            "end_effector_rotation_relative": states[:, :, 3:7].numpy(),
+            "gripper_qpos": states[:, :, 7:9].numpy(),
+            "base_position": states[:, :, 9:12].numpy(),
+            "base_rotation": states[:, :, 12:16].numpy(),
+        },
+        # (B, 1) list-of-lists, matching RLDXPolicy's language format
+        "language": {
