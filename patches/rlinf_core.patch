+
+"""RLDX-1 embodied-RL model builder for RLinf.
+
+Loads a native RLDX-1 checkpoint (model + processor) through RLDX-1's own
+PolicyLoader (which handles memory deactivation, processor statistics, etc.),
+then wraps it in ``RLDX1_ForRLActionPrediction`` and attaches the flow-matching
+RL head + value head. Value head is re-initialized post-load (checkpoint has no
+value head; uninitialized -> NaN, same as the GR00T builder).
+"""
+
+import torch
+from omegaconf import DictConfig
+
+
+def get_model(cfg: DictConfig, torch_dtype=torch.bfloat16):
+    import sys
+
+    # RLDX-1 model code lives outside RLinf; make it importable without editing
+    # RLDX-1 sources (env-isolation: read-only dependency).
+    rldx1_root = cfg.get("rldx1_repo_path", __import__("os").environ.get("RLDX1_ROOT", "RLDX-1"))
+    if rldx1_root not in sys.path:
+        sys.path.insert(0, rldx1_root)
+
+    from rldx.data.embodiment_tags import EmbodimentTag
+    from rldx.policy.policy_loader import PolicyLoader
+
+    from rlinf.models.embodiment.rldx1.rldx1_action_model import (
+        RLDX1_ForRLActionPrediction,
+    )
+
+    embodiment_tag = EmbodimentTag(cfg.embodiment_tag)
+
+    # device: PolicyLoader loads onto a device; RLinf worker moves it afterwards.
+    loaded = PolicyLoader.load(
+        embodiment_tag=embodiment_tag,
+        model_path=cfg.model_path,
+        device="cpu",
+        deactivate_memory=True,  # this ckpt has use_memory=false; force-off for safety
+    )
+
+    # RL trains ONLY the action head (MSAT) + value head; the VLM backbone stays
+    # frozen. The SFT ckpt was trained with tune_top_llm_layers>0, so ~14.6% of
+    # the backbone (top Qwen3-VL decoder layers) is left with requires_grad=True on
+    # load. Freeze the whole backbone (qwen_model + qwen_linear + cog_emb): this
+    # (a) honors the "no VLM training" constraint and (b) gives every FSDP unit
+    # inside the backbone a uniform requires_grad, which FSDP1 needs. (The frozen
+    # backbone + trainable action_model still mix at the FSDP root flat unit, which
+    # is why the configs also set fsdp_config.use_orig_params=True.)
+    loaded.model.backbone.requires_grad_(False)
+
+    adapter = RLDX1_ForRLActionPrediction(
+        rldx_model=loaded.model,
+        processor=loaded.processor,
+        rl_head_config=cfg.rl_head_config,
+        embodiment_tag=embodiment_tag,
+        output_action_chunks=cfg.num_action_chunks,
+        compute_dtype=torch_dtype,
+    )
+    adapter.to(torch_dtype)
+
+    if cfg.rl_head_config.add_value_head:
+        # re-init value head after loading (ckpt lacks it -> NaN otherwise)
+        adapter.rl_head.value_head._init_weights()
+
+    # Honor rl_head_config.disable_dropout, exactly like the GR00T builder
+    # (replace_dropout_with_identity). RLDX-1's MSAT DiT is built with
+    # diffusion_model_cfg.dropout=0.2 + final_dropout=True (see rldx.py:47-48),
+    # so any nn.Dropout stays live whenever the module is in .train() mode.
+    # The actor flips the model to .train() for the logprob recompute
+    # (fsdp_actor_worker.py:835) while the rollout runs it in .eval(): with
+    # dropout active only on the actor side, the two forwards see different
+    # masks and the PPO importance ratio is corrupted from step 0. Neutralize
+    # dropout so rollout and recompute are consistent (GR00T does the same).
+    if cfg.rl_head_config.get("disable_dropout", False):
+        import torch.nn as nn
+
+        for name, module in list(adapter.named_modules()):
+            if isinstance(
+                module,
+                (nn.Dropout, nn.Dropout1d, nn.Dropout2d, nn.Dropout3d, nn.AlphaDropout),
+            ):
+                parent = adapter
+                child = name
+                if "." in name:
+                    parent_name, child = name.rsplit(".", 1)
+                    parent = dict(adapter.named_modules())[parent_name]
+                setattr(parent, child, nn.Identity())
+
+    return adapter
