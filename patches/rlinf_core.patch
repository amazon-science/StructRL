+"""RLDX-1 flow-matching RL head.
+
+Mirrors ``gr00t_action_model.FlowMatchingActionHeadForRLActionPrediction`` but
+targets RLDX-1's MSAT (Multi-Stream Action Transformer). RLDX-1 and GR00T use
+the *same* rectified-flow convention (t: 0->1, x0=noise, x1=data;
+velocity = data - noise), so GR00T's ODE->SDE logprob machinery transfers
+verbatim. Verified numerically on the real 6.9B ckpt in
+``RLDX-1/notes/p1b_real_msat_logprob.py`` (logprob finite, noise->0 degenerates
+to the deterministic Euler denoiser at 6e-8, differentiable w.r.t. MSAT params).
+
+This module operates purely on the tensors the RLDX backbone already produces
+(``backbone_features`` = 64 cog tokens @ dim 4096, ``state_features``,
+``embodiment_id``); it never touches the VLM backbone or RLDX-1's obs/action IO,
+which the adapter delegates to RLDX-1's native RLDXProcessor.
+"""
+
+import random
+from typing import Any, Literal, Optional
+
+import torch
+import torch.nn as nn
+from transformers.feature_extraction_utils import BatchFeature
+
+from rlinf.models.embodiment.modules.value_head import ValueHead
+
+
+class RLDX1RLHead(nn.Module):
+    """Owns the value head and the flow-matching SDE sampling/logprob logic.
+
+    A reference to the frozen-topology RLDX ``action_model`` (an
+    ``RLDXActionModel``) is passed into every call rather than stored, so this
+    head introduces no duplicate parameters and FSDP wraps a single module tree.
+    """
+
+    def __init__(self, rl_config: dict[str, Any], backbone_dim: int, state_dim: int):
+        super().__init__()
+        self.rl_config = rl_config
+        self.global_step = 0
+        self.add_value_head = rl_config.add_value_head
+
+        if self.add_value_head:
+            if rl_config.use_vlm_value:
+                input_dim = backbone_dim
+            else:
+                input_dim = backbone_dim + state_dim
+            self.value_head = ValueHead(
+                input_dim=input_dim,
+                hidden_sizes=(1024, 512, 256),
+                output_dim=1,
+                activation="relu",
+                bias_last=True,
+            )
+
+    # ------------------------------------------------------------------ logprob
+    def get_logprob_norm(self, sample, mu, sigma):
+        """Diagonal-Gaussian logprob; sigma==0 (eval/deterministic step) -> 0."""
+        mask = sigma == 0
+        sigma_safe = torch.where(mask, torch.ones_like(sigma), sigma)
+        constant_term = -torch.log(sigma_safe) - 0.5 * torch.log(
+            2 * torch.pi * torch.ones_like(sample)
+        )
+        exponent_term = -0.5 * torch.pow((sample - mu) / sigma_safe, 2)
+        log_prob = constant_term + exponent_term
+        return torch.where(mask, torch.zeros_like(log_prob), log_prob)
+
+    # ------------------------------------------------------- single MSAT step
+    def _msat_velocity(self, am, x_t, timesteps_tensor, embodiment_id,
+                       state_features, vl_embs, vl_attn_mask):
+        """One MSAT forward -> velocity, aligned with
+        RLDX get_action_with_features._dit_forward (rldx.py:623-718).
+
+        ``timesteps_tensor`` is the per-sample continuous t in [0,1], shape (B,).
+        The action encoder wants per-token timesteps (B, H)."""
+        horizon = am.config.action_horizon
+        t_tok = timesteps_tensor.unsqueeze(1).expand(-1, horizon)
+        action_features = am.action_encoder(x_t, t_tok, embodiment_id)
+        if am.config.add_pos_embed:
+            pos_ids = torch.arange(
+                action_features.shape[1], dtype=torch.long, device=x_t.device
+            )
+            action_features = action_features + am.position_embedding(pos_ids).unsqueeze(0)
+        sa_embs = torch.cat((state_features, action_features), dim=1)
+        model_output = am.model(
+            hidden_states=sa_embs,
+            encoder_hidden_states=vl_embs,
+            timestep=timesteps_tensor,
+            encoder_attention_mask=vl_attn_mask,
+        )
+        model_output = model_output["action"] if isinstance(model_output, dict) else model_output
+        v_t = am.action_decoder(model_output, embodiment_id)[:, -horizon:]
+        return v_t
+
+    # --------------------------------------------------- mean / std at step idx
+    def sample_mean_var_val(
+        self,
+        am,
+        vl_embs: torch.Tensor,
+        denoise_steps: int,
+        x_t: torch.Tensor,
+        embodiment_id: torch.Tensor,
+        state_features: torch.Tensor,
+        idx,
+        mode: Literal["train", "eval"] = "train",
+        vl_attn_mask: Optional[torch.Tensor] = None,
+    ):
+        """Mean & std of the (S)DE transition at denoise step ``idx``.
+
+        RLDX/GR00T time convention: t:0->1, x0=noise, x1=data. Direct transfer
+        of gr00t sample_mean_var_val (gr00t_action_model.py:101-219). ``idx`` is
+        an int (rollout) or a per-sample LongTensor (actor recompute)."""
+        bsize = vl_embs.shape[0]
+        device = vl_embs.device
+        if isinstance(idx, int):
+            idx = torch.tensor(idx, device=device).expand(bsize)
+        else:
+            idx = idx.to(device)
+
+        if self.rl_config.noise_anneal:
+            noise_start, noise_end, anneal_steps = self.rl_config.noise_params
+            noise_level = noise_start + (noise_end - noise_start) * min(
+                self.global_step, anneal_steps
+            ) / anneal_steps
+            noise_level = torch.tensor(noise_level).to(device)
+        else:
+            noise_level = torch.tensor(self.rl_config.noise_level).to(device)
+
+        # continuous t for the MSAT (RLDX feeds the raw fractional time, not buckets)
+        t_cont = idx.to(vl_embs.dtype) / float(denoise_steps)
+        v_t = self._msat_velocity(
+            am, x_t, t_cont, embodiment_id, state_features, vl_embs, vl_attn_mask
+        )
+
+        timesteps = torch.linspace(0, 1, denoise_steps + 1, device=device, dtype=vl_embs.dtype)
+        t_input = timesteps[idx]
+        delta = timesteps[idx + 1] - timesteps[idx]
+        delta = delta[:, None, None].expand_as(x_t)
+        t_input = t_input[:, None, None].expand_as(x_t)
+        # x0: noise direction, x1: data direction
+        x0_pred = x_t - v_t * t_input
+        x1_pred = x_t + v_t * (1 - t_input)
+
+        if mode == "eval":
+            x0_weight = 1 - (t_input + delta)
+            x1_weight = t_input + delta
+            x_t_std = torch.zeros_like(t_input)
+        elif mode == "train":
+            if self.rl_config.noise_method == "flow_sde":
+                sigmas = (
+                    noise_level
+                    * torch.sqrt(
+                        (1 - timesteps)
+                        / torch.where(timesteps == 0, timesteps[1], timesteps)
+                    )[:-1]
+                )
+                sigma_i = sigmas[idx][:, None, None].expand_as(x_t)
+                x0_weight = (
+                    torch.ones_like(t_input)
+                    - (t_input + delta)
+                    - sigma_i**2 * delta / (2 * (1 - t_input))
+                )
+                x1_weight = t_input + delta
+                x_t_std = torch.sqrt(delta) * sigma_i
+            elif self.rl_config.noise_method == "flow_cps":
+                pi = torch.pi
+                cos_term = torch.cos(pi * noise_level / 2).to(device)
+                sin_term = torch.sin(pi * noise_level / 2).to(device)
+                x0_weight = (torch.ones_like(t_input) - (t_input + delta)) * cos_term
+                x1_weight = t_input + delta
+                x_t_std = (1 - (t_input + delta)) * sin_term
+            else:
+                raise ValueError(f"Invalid noise method: {self.rl_config.noise_method}")
+        x_t_mean = x0_pred * x0_weight + x1_pred * x1_weight
+        return x_t_mean, x_t_std
+
+    def sample_noise(self, shape, device, dtype):
+        return torch.normal(mean=0.0, std=1.0, size=shape, dtype=dtype, device=device)
+
+    # -------------------------------------------------------------- value head
+    def get_value(self, vl_embs, state_features, vl_attn_mask=None):
+        """Pool the 64 cog tokens (mirror gr00t get_value:415-439) -> scalar."""
+        bsize = vl_embs.shape[0]
+        mask_length = vl_embs.shape[1]
+        if self.rl_config.value_vlm_mode == "mean_token":
+            prefix_mask = [True] * mask_length
+        elif self.rl_config.value_vlm_mode == "last_token":
+            prefix_mask = [False] * (mask_length - 1) + [True]
+        elif self.rl_config.value_vlm_mode == "first_token":
+            prefix_mask = [True] + [False] * (mask_length - 1)
+        vl_embs_value = vl_embs[:, prefix_mask, :]
+        if self.rl_config.value_vlm_mode == "mean_token" and vl_attn_mask is not None:
+            m = vl_attn_mask[:, prefix_mask].to(vl_embs_value.dtype).unsqueeze(-1)
+            vl_embs_value = (vl_embs_value * m).sum(dim=1) / m.sum(dim=1).clamp(min=1.0)
+        else:
+            vl_embs_value = vl_embs_value.mean(dim=1)
+        if self.rl_config.detach_critic_input:
+            vl_embs_value = vl_embs_value.detach()
+        if self.rl_config.use_vlm_value:
+            value_embs = vl_embs_value
+        else:
+            state_features_value = state_features.reshape(bsize, -1)
+            if self.rl_config.detach_critic_input:
+                state_features_value = state_features_value.detach()
+            value_embs = torch.cat((vl_embs_value, state_features_value), dim=1)
+        return self.value_head(value_embs)[:, 0]
+
+    # -------------------------------------------------------------- rollout
+    def get_rl_action(
+        self,
+        am,
+        vl_embs,
+        state_features,
+        embodiment_id,
+        vl_attn_mask=None,
+        mode: Literal["train", "eval"] = "train",
+        compute_values=True,
+    ):
+        """Denoise from noise, injecting SDE noise at one random step (train) so
+        that step carries a tractable logprob. Returns final action + chains +
+        per-step logprobs + values + the sampled denoise index."""
+        device = vl_embs.device
+        dtype = vl_embs.dtype
+        batch_size = vl_embs.shape[0]
+        horizon = am.config.action_horizon
+        action_dim = am.action_dim
+        num_steps = am.num_inference_timesteps
+
+        x_t = torch.randn(size=(batch_size, horizon, action_dim), dtype=dtype, device=device)
+        chains = [x_t]
+        log_probs = []
+
+        if mode == "train":
+            if self.rl_config.noise_method == "flow_sde" and self.rl_config.ignore_last:
+                denoise_inds = torch.tensor([random.randint(0, num_steps - 2)] * num_steps,
+                                            device=device)
+            else:
+                denoise_inds = torch.tensor([random.randint(0, num_steps - 1)] * num_steps,
+                                            device=device)
+        else:
+            denoise_inds = torch.tensor([-1] * num_steps, device=device)
+        denoise_inds = denoise_inds[None].repeat(batch_size, 1)
+
+        for idx in range(num_steps):
+            step_mode = "train" if idx == denoise_inds[0][idx] else "eval"
+            x_t_mean, x_t_std = self.sample_mean_var_val(
+                am, vl_embs=vl_embs, idx=idx, x_t=x_t, embodiment_id=embodiment_id,
+                state_features=state_features, mode=step_mode, denoise_steps=num_steps,
+                vl_attn_mask=vl_attn_mask,
+            )
+            x_t = x_t_mean + self.sample_noise(x_t.shape, device, dtype) * x_t_std
+            log_probs.append(self.get_logprob_norm(x_t, x_t_mean, x_t_std))
+            chains.append(x_t)
+
+        x_0 = x_t
+        chains = torch.stack(chains, dim=1)
+        log_probs = torch.stack(log_probs, dim=1)
+        if compute_values and self.add_value_head:
+            values = self.get_value(vl_embs, state_features, vl_attn_mask=vl_attn_mask)[:, None]
+        else:
+            values = torch.zeros((batch_size, 1), device=device, dtype=dtype)
+
+        return x_0, {
+            "chains": chains,
+            "prev_logprobs": log_probs,
+            "prev_values": values,
+            "denoise_inds": denoise_inds,
+        }
+
+    # -------------------------------------------------------------- recompute
+    def recompute_logprob_value(
+        self,
+        am,
+        vl_embs,
+        state_features,
+        embodiment_id,
+        chains,
+        denoise_inds,
+        vl_attn_mask=None,
+        compute_values=True,
+    ):
+        """Actor-side: recompute logprob (and value) for the stored action at the
+        stored denoise step under current params. Mirrors gr00t forward:336-404."""
+        device = vl_embs.device
+        batch_size = vl_embs.shape[0]
+        denoise_ind = denoise_inds[:, 0]
+        chains_pre = chains[torch.arange(batch_size), denoise_ind]
+        chains_next = chains[torch.arange(batch_size), denoise_ind + 1]
+        x_t_mean, x_t_std = self.sample_mean_var_val(
+            am, vl_embs=vl_embs, idx=denoise_ind, x_t=chains_pre,
+            embodiment_id=embodiment_id, state_features=state_features, mode="train",
+            denoise_steps=am.num_inference_timesteps, vl_attn_mask=vl_attn_mask,
+        )
+        log_probs = self.get_logprob_norm(chains_next, x_t_mean, x_t_std)
+        if compute_values and self.add_value_head:
+            values = self.get_value(vl_embs, state_features, vl_attn_mask=vl_attn_mask)[:, None]
+        else:
+            values = torch.zeros((batch_size, 1), device=device, dtype=vl_embs.dtype)
+        return log_probs, values
