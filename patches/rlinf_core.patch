+# limitations under the License.
+
+"""Subprocess vectorized environment for RoboCasa365 (GrootRoboCasaEnv).
+
+Unlike rlinf.envs.robocasa (which wraps a raw robosuite env returning 4 values
+and needs a _check_success hook), GrootRoboCasaEnv is a gymnasium env: reset ->
+(obs, info), step -> (obs, reward, terminated, truncated, info), and info
+already carries "success". So the worker just forwards the native returns.
+"""
+
+import multiprocessing
+from multiprocessing import connection
+from typing import Any, Callable, Optional, Union
+
+import gymnasium as gym
+import numpy as np
+
+from rlinf.envs.venv import (
+    BaseVectorEnv,
+    CloudpickleWrapper,
+    EnvWorker,
+    ShArray,
+    SubprocEnvWorker,
+    SubprocVectorEnv,
+    _setup_buf,
+)
+
+
+def _worker(
+    parent: connection.Connection,
+    p: connection.Connection,
+    env_fn_wrapper: CloudpickleWrapper,
+    obs_bufs: Optional[Union[dict, tuple, ShArray]] = None,
+) -> None:
+    def _encode_obs(
+        obs: Union[dict, tuple, np.ndarray], buffer: Union[dict, tuple, ShArray]
+    ) -> None:
+        if isinstance(obs, np.ndarray) and isinstance(buffer, ShArray):
+            buffer.save(obs)
+        elif isinstance(obs, tuple) and isinstance(buffer, tuple):
+            for o, b in zip(obs, buffer):
+                _encode_obs(o, b)
+        elif isinstance(obs, dict) and isinstance(buffer, dict):
+            for k in obs.keys():
+                _encode_obs(obs[k], buffer[k])
+        return None
+
+    parent.close()
+    env = env_fn_wrapper.data()
+    # Per-env latched state for incremental dense reward (variant C).
+    # Only fires reward on FIRST-TIME completion of each progress subtask
+    # and the outcome. Reset to 0 on env.reset().
+    #   _latched_n_done: max n_total_done seen so far this episode
+    #   _latched_outcome: True once env._check_success() ever fired
+    latched_n_done = 0
+    latched_outcome = False
+
+    # Per-env TimingReward (stage-based, demo-timing-budgeted dense reward).
+    # Built lazily on first step (we need the leaf env's class name to pick
+    # the task's stage def + budgets) and rebuilt on every env.reset() so each
+    # episode times from t=0. This is the SAME reward the offline video overlay
+    # (structrl/visualize_timing_reward.py) renders.
+    timing_reward = None
+    timing_data = None
+    timing_task_name = None
+    try:
+        while True:
+            try:
+                cmd, data = p.recv()
+            except EOFError:  # the pipe has been closed
+                p.close()
+                break
+            if cmd == "step":
+                # GrootRoboCasaEnv.step -> (obs, reward, terminated, truncated, info)
+                env_return = env.step(data)
+                # Inject dense subtask-progress reward into info dict so the
+                # main process can pick it up and (optionally) replace the
+                # sparse 0/1 outcome reward with it. Compute here in the
+                # subprocess because env.sim.data / env.coffee_machine etc.
+                # live in this process, not in the main process.
+                # ALWAYS write the keys (even on failure → 0.0 fallback) so
+                # list_of_dict_to_dict_of_list in the main process sees a
+                # consistent key set across all envs.
+                obs_, reward_, term_, trunc_, info_ = env_return
+                if not isinstance(info_, dict):
+                    info_ = dict(info_) if info_ else {}
+                # Variant C (latched / first-time-only) outputs:
+                #   _dr_total: incremental reward this step (0 most steps,
+                #              0..1/N_total at first completion of a progress,
+                #              1.0 at first outcome=True)
+                #   _dr_inst_*: also report the instantaneous (variant A) values
+                #              for diagnostics so we can compare side-by-side
+                _dr_total, _dr_prog_inc, _dr_out_inc = 0.0, 0.0, 0.0
+                _dr_inst_total, _dr_inst_prog, _dr_inst_out = 0.0, 0.0, 0.0
+                _dr_nd, _dr_nt = 0, 0
+                try:
+                    # The structrl copy in site-packages is a stale partial
+                    # (only __init__ + robocasa_data_config), missing the
+                    # timing-reward modules. The full source lives in the
+                    # project root, so prepend it to sys.path before importing
+                    # so we resolve to source, not the stale site-packages copy.
+                    # Independent of PYTHONPATH inheritance into spawned workers.
+                    import os
+                    import sys
+                    _proj_root = os.environ.get(
+                        "STRUCTRL_PROJECT_ROOT",
+                        os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "..")),
+                    )
+                    # The sbatch heredoc may leave this as an unexpanded
+                    # literal (e.g. '"${PROJECT_ROOT}"') when eval'd in the
+                    # main shell. Validate it points at a real structrl dir;
+                    # fall back to the known absolute path otherwise.
+                    if not os.path.isdir(os.path.join(_proj_root, "structrl")):
+                        _proj_root = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", ".."))
+                    if _proj_root not in sys.path:
+                        sys.path.insert(0, _proj_root)
+                    # Drop any already-imported stale structrl so the source
+                    # copy (with subtask_checker etc.) is the one loaded.
+                    _stale = getattr(
+                        sys.modules.get("structrl", None), "__file__", ""
+                    ) or ""
+                    if "site-packages" in _stale:
+                        for _m in list(sys.modules):
+                            if _m == "structrl" or _m.startswith("structrl."):
+                                del sys.modules[_m]
+                    from structrl.subtask_checker import get_subtask_states
+                    from structrl.timing_reward_builder import (
+                        build_timing_reward,
+                        load_timing_data,
+                    )
+                    # Reward variant (STRUCTRL_REWARD_VARIANT):
+                    #   structrl (= smooth_band): the paper's reward, gated
+                    #       subtask credit paced by beta / (1 + T / T_d);
+                    #   fixed (= flat): gated fixed subtask reward (ablation);
+                    #   smooth_band_cap10: beta = 1.0 (beta sweep);
+                    #   timing (default), smooth_timing: earlier variants with
+                    #       a persistent stuck penalty (not used in the paper).
+                    _reward_variant = os.environ.get(
+                        "STRUCTRL_REWARD_VARIANT", "timing"
+                    ).strip().lower()
+                    _reward_variant = {
+                        "structrl": "smooth_band", "fixed": "flat",
+                    }.get(_reward_variant, _reward_variant)
+                    # Unwrap to the leaf robosuite env. Layer chain in
+                    # rlinf/envs/robocasa365/robocasa365_env.py:get_env_fns:
+                    #   _ActionDictAdapter (env) -> GrootRoboCasaEnv (env)
+                    #     -> robosuite robocasa task env
+                    # So we need 3 levels of `.env`. Walk it dynamically in
+                    # case the wrapper depth changes.
+                    inner = env
+                    for _ in range(5):  # bounded; usually 2 hops
+                        if hasattr(inner, "_check_success"):
+                            break
+                        if not hasattr(inner, "env"):
+                            break
+                        inner = inner.env
+
+                    # Lazily build the reward object for this env's task.
+                    if timing_reward is None:
+                        if timing_data is None:
+                            timing_data = load_timing_data()
+                        timing_task_name = type(inner).__name__
+                        if _reward_variant == "flat":
+                            from structrl.flat_reward import build_flat_reward
+                            timing_reward = build_flat_reward(
+                                timing_task_name, timing_data
+                            )
+                        elif _reward_variant == "smooth_timing":
+                            # Full timing reward (#1+#2+#3) with ONLY the ratio
+                            # band's functional form swapped from the 3-piece
+                            # piecewise map to the smooth knob-free curve
+                            # 0.6/(1+ratio). persistent + outcome unchanged.
+                            from structrl.smooth_timing_reward import (
+                                build_smooth_timing_reward,
+                            )
+                            timing_reward = build_smooth_timing_reward(
+                                timing_task_name, timing_data
+                            )
+                        elif _reward_variant == "smooth_band":
+                            # Continuous band (#1 + #2 smooth 0.6/(1+ratio)) but
+                            # NO persistent stuck penalty (#3). Smooth-curve
+                            # counterpart of "band"; smooth_band vs smooth_timing
+                            # isolates r_persistent under the continuous band.
+                            from structrl.smooth_band_reward import (
+                                build_smooth_band_reward,
+                            )
+                            timing_reward = build_smooth_band_reward(
+                                timing_task_name, timing_data
+                            )
+                        elif _reward_variant == "smooth_band_cap10":
+                            # smooth_band with the continuous band cap raised
+                            # 0.6 -> 1.0 (numerator 1.0/(1+ratio); anchor at
+                            # ratio=1 moves 0.3 -> 0.5). No persistent penalty,
+                            # same form as smooth_band otherwise.
+                            from structrl.smooth_band_cap10_reward import (
+                                build_smooth_band_cap10_reward,
+                            )
+                            timing_reward = build_smooth_band_cap10_reward(
+                                timing_task_name, timing_data
+                            )
+                        else:
+                            timing_reward = build_timing_reward(
+                                timing_task_name, timing_data
+                            )
+
+                    grouped = get_subtask_states(inner)
+                    success = bool(inner._check_success())
+
+                    # Advance the timer in REAL sim-step units. robosuite's
+                    # env.timestep is the per-sim-step counter; budgets are
+                    # sim-step-based, so pass it explicitly (same as the video
+                    # overlay) rather than relying on TimingReward's internal
+                    # +1, which would count chunk-sub-steps inconsistently.
+                    sim_t = None
+                    try:
+                        sim_t = int(getattr(inner, "timestep"))
+                    except Exception:
+                        sim_t = None
+                    tinfo = timing_reward.step(grouped, success, sim_t=sim_t)
+
+                    # r_total is the per-step timing reward that DRIVES PPO.
+                    _dr_total = float(tinfo["r_total"])
+                    _dr_prog_inc = float(tinfo["r_event"]) + float(
+                        tinfo["r_persistent"]
+                    )
+                    _dr_out_inc = float(tinfo["r_outcome"])
+                    # Reuse the n_done/n_total channels for stage progress so
+                    # the existing env_worker diagnostics still populate.
+                    _dr_nd = int(tinfo["stage_idx_after"])
+                    _dr_nt = int(timing_reward.K)
+                    _dr_inst_total = float(tinfo["cumulative"])
+                    _dr_inst_prog = float(tinfo["cumulative_progress"])
+                    _dr_inst_out = float(tinfo["cumulative_outcome"])
+                    latched_outcome = bool(tinfo["cumulative_outcome"] > 0)
+                    latched_n_done = _dr_nd
+                except Exception as _e:
+                    # First-time error — log to stderr in subprocess so we
+                    # can see WHY dense reward fails. Subsequent errors
+                    # silenced to avoid spam.
+                    if not getattr(_worker, "_logged_dr_err", False):
+                        import sys
+                        import traceback
+                        print(f"[venv worker] timing_reward error: {type(_e).__name__}: {_e}", file=sys.stderr, flush=True)
+                        traceback.print_exc()
+                        _worker._logged_dr_err = True
+                # Timing reward (the one that actually replaces chunk_rewards
+                # in env_worker.py when dense_reward.enabled=True)
+                info_["dense_reward"] = _dr_total
+                info_["dense_reward_progress"] = _dr_prog_inc
+                info_["dense_reward_outcome"] = _dr_out_inc
+                info_["dense_reward_n_done"] = _dr_nd
+                info_["dense_reward_n_total"] = _dr_nt
+                # Side-channel: cumulative timing totals for logging
+                info_["dense_reward_inst"] = _dr_inst_total
+                info_["dense_reward_inst_progress"] = _dr_inst_prog
+                info_["dense_reward_inst_outcome"] = _dr_inst_out
+                # Latched state visible for plotting
+                info_["dense_reward_latched_n_done"] = latched_n_done
+                info_["dense_reward_latched_outcome"] = (
+                    1 if latched_outcome else 0
+                )
+                env_return = (obs_, reward_, term_, trunc_, info_)
+                if obs_bufs is not None:
+                    _encode_obs(env_return[0], obs_bufs)
+                    env_return = (None, *env_return[1:])
+                p.send(env_return)
+            elif cmd == "reset":
+                # GrootRoboCasaEnv.reset -> (obs, info)
+                retval = env.reset(**data)
+                reset_returns_info = (
+                    isinstance(retval, (tuple, list))
+                    and len(retval) == 2
+                    and isinstance(retval[1], dict)
+                )
+                if reset_returns_info:
+                    obs, info = retval
+                else:
+                    obs = retval
+                    info = {}
+                # CRITICAL: clear latched state on reset so each new episode
+                # starts fresh. Without this, the second episode's first
+                # progress completion would be silently swallowed.
+                latched_n_done = 0
+                latched_outcome = False
+                # Reset the TimingReward so the new episode times from t=0
+                # (stage_idx, subtask_start_step, cumulative all cleared).
+                if timing_reward is not None:
+                    timing_reward.reset()
+                if obs_bufs is not None:
+                    _encode_obs(obs, obs_bufs)
+                    obs = None
+                p.send((obs, info))
+            elif cmd == "close":
+                p.send(env.close())
+                p.close()
+                break
+            elif cmd == "render":
+                p.send(env.render(**data) if hasattr(env, "render") else None)
+            elif cmd == "seed":
+                if hasattr(env, "seed"):
+                    p.send(env.seed(data))
+                else:
+                    env.reset(seed=data)
+                    p.send(None)
+            elif cmd == "getattr":
+                p.send(getattr(env, data) if hasattr(env, data) else None)
+            elif cmd == "setattr":
+                setattr(env.unwrapped, data["key"], data["value"])
+            else:
+                p.close()
+                raise NotImplementedError(f"Unknown command: {cmd}")
+    except KeyboardInterrupt:
+        p.close()
+
+
+class RoboCasa365SubprocEnvWorker(SubprocEnvWorker):
+    def __init__(self, env_fn: Callable[[], gym.Env], share_memory: bool = False):
+        # spawn context to avoid MuJoCo/OpenGL fork issues
+        ctx = multiprocessing.get_context("spawn")
+        self.parent_remote, self.child_remote = ctx.Pipe()
+        self.share_memory = share_memory
+        self.buffer: Optional[Union[dict, tuple, ShArray]] = None
+        if self.share_memory:
+            dummy = env_fn()
+            obs_space = dummy.observation_space
+            dummy.close()
+            del dummy
+            self.buffer = _setup_buf(obs_space)
+        args = (
+            self.parent_remote,
+            self.child_remote,
+            CloudpickleWrapper(env_fn),
+            self.buffer,
+        )
+        self.process = ctx.Process(target=_worker, args=args, daemon=True)
+        self.process.start()
+        self.child_remote.close()
+        EnvWorker.__init__(self, env_fn)
+
+
+class RoboCasa365SubprocEnv(SubprocVectorEnv):
+    def __init__(self, env_fns: list[Callable[[], gym.Env]], **kwargs: Any) -> None:
+        def worker_fn(fn: Callable[[], gym.Env]) -> RoboCasa365SubprocEnvWorker:
+            # Robosuite dict observations work better without shared memory.
+            return RoboCasa365SubprocEnvWorker(fn, share_memory=False)
+
+        BaseVectorEnv.__init__(self, env_fns, worker_fn, **kwargs)
+
+    def step(self, action, id=None):
+        # GrootRoboCasaEnv is gymnasium-style: workers return 5 values
+        # (obs, reward, terminated, truncated, info). RobocasaEnv.step expects
+        # the robosuite 4-tuple (obs, reward, done, info) and recomputes
+        # terminations/truncations itself, so collapse the two done flags here.
+        obs, reward, terminated, truncated, info = super().step(action, id)
+        done = np.logical_or(terminated, truncated)
+        return obs, reward, done, info
