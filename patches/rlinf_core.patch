diff --git a/rlinf/envs/robocasa365/robocasa365_env.py b/rlinf/envs/robocasa365/robocasa365_env.py
new file mode 100644
index 00000000..18505cfe
--- /dev/null
+++ b/rlinf/envs/robocasa365/robocasa365_env.py
@@ -0,0 +1,318 @@
+# Copyright 2025 The RLinf Authors.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     https://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""RoboCasa365 environment for RLinf, wrapping the user's GrootRoboCasaEnv.
+
+This is the REAL RoboCasa365 (v1.0.0) gym env that the user's GR00T checkpoint
+was SFT'd against, so observations/actions are byte-for-byte aligned with the
+ckpt's training spec. We reuse the generic rollout machinery (metrics,
+chunk_step, auto-reset, reward) from RobocasaEnv and only override the
+env-construction and obs/action plumbing.
+
+Data contract bridged here:
+  - GrootRoboCasaEnv emits GR00T-format dict obs (state.*, video.res256_*,
+    annotation...). We re-flatten it into the RLinf contract
+    (main_images / wrist_images / extra_view_images / states[B,16] /
+    task_descriptions) in _wrap_obs.
+  - The model emits a flat 12-D action; an in-subprocess adapter
+    (_ActionDictAdapter) converts it back into the action dict GrootRoboCasaEnv
+    expects, so the [num_envs, 12] numpy contract stays intact through the base
+    venv/step/chunk_step.
+"""
+
+import gymnasium as gym
+import numpy as np
+import torch
+
+from rlinf.envs.robocasa.robocasa_env import RobocasaEnv
+from rlinf.envs.robocasa365.venv import RoboCasa365SubprocEnv
+from rlinf.envs.utils import list_of_dict_to_dict_of_list, to_tensor
+
+# GrootRoboCasaEnv obs keys (PandaOmronKeyConverter) -> RLinf flat image keys.
+# side_0=agentview_left (main), side_1=agentview_right (extra), wrist_0=eye_in_hand.
+GROOT_IMAGE_KEY_MAPPING = {
+    "main_images": "video.res256_image_side_0",
+    "extra_view_images": "video.res256_image_side_1",
+    "wrist_images": "video.res256_image_wrist_0",
+}
+
+# Raw 16-D state assembled in SFT state_keys order.
+GROOT_STATE_KEYS = [
+    ("state.end_effector_position_relative", 3),
+    ("state.end_effector_rotation_relative", 4),
+    ("state.gripper_qpos", 2),
+    ("state.base_position", 3),
+    ("state.base_rotation", 4),
+]
+
+
+class _ActionDictAdapter(gym.Wrapper):
+    """Converts a flat 12-D action vector into the dict GrootRoboCasaEnv wants.
+
+    Layout (SFT action_keys order):
+        [0:3] eef_position, [3:6] eef_rotation, [6] gripper_close,
+        [7:11] base_motion, [11] control_mode.
+    """
+
+    def step(self, action):
+        a = np.asarray(action, dtype=np.float32).reshape(-1)
+        assert a.shape[0] == 12, f"Expected 12-D action, got {a.shape[0]}"
+        action_dict = {
+            "action.end_effector_position": a[0:3],
+            "action.end_effector_rotation": a[3:6],
+            "action.gripper_close": float(a[6]),
+            "action.base_motion": a[7:11],
+            "action.control_mode": float(a[11]),
+        }
+        return self.env.step(action_dict)
+
+
+class RoboCasa365Env(RobocasaEnv):
+    def _init_env(self):
+        """Build GrootRoboCasaEnv instances under subprocess isolation."""
+        import robocasa  # noqa: F401  register envs
+        import robocasa.utils.gym_utils.gymnasium_groot  # noqa: F401  register groot env ids
+
+        # Two task-assignment strategies, controlled by env cfg flag
+        # `per_rank_single_task` (default False = legacy global round-robin):
+        #
+        # (a) GLOBAL round-robin (default, matches parent RobocasaEnv):
+        #     Every per-rank env_id maps to a different task via the global
+        #     env id. With num_envs=8 and num_tasks=16:
+        #       rank 0  -> tasks [0, 1, 2, 3, 4, 5, 6, 7]
+        #       rank 1  -> tasks [8, 9, 10, 11, 12, 13, 14, 15]
+        #       rank 2  -> tasks [0..7] (wraps), etc.
+        #     Each rank's PPO advantage normalization sees a healthy mix of
+        #     tasks => non-degenerate (mean, std). Use this for fix-lambda
+        #     IBRL, pure RL, and global dynamic-lambda IBRL.
+        #
+        # (b) PER-RANK single-task (opt-in via env.train.per_rank_single_task=True):
+        #     Every env on a given rank runs the SAME task, consecutive ranks
+        #     run consecutive tasks. Required by ibrl_mode=dynamic_per_task,
+        #     so each rank can apply its task's own lambda cleanly. Note: a
+        #     rank's advantage normalization may degenerate when its task is
+        #     all-fail or all-succeed (PPO loss -> 0 for that rank).
+        per_rank_single_task = bool(self.cfg.get("per_rank_single_task", False))
+        self.task_ids = []
+        if per_rank_single_task:
+            task_idx = self.seed_offset % self.num_tasks
+            self.task_ids = np.full(self.num_envs, task_idx, dtype=np.int64)
+        else:
+            # Group-aware (GRPO): all `group_size` envs in a group share one
+            # task, keyed by the global GROUP id. Identity at group_size=1
+            # (global_group_id == legacy global env id). Matches env_seeds set
+            # by the parent RobocasaEnv._init_reset_state_ids so a group's task
+            # and init scene coincide.
+            for env_id in range(self.num_envs):
+                local_group_id = env_id // self.group_size
+                global_group_id = self.seed_offset * self.num_group + local_group_id
+                task_idx = global_group_id % self.num_tasks
+                self.task_ids.append(task_idx)
+            self.task_ids = np.array(self.task_ids)
+
+        env_fns = self.get_env_fns()
+        self.env = RoboCasa365SubprocEnv(env_fns)
+
+    # RoboCasa365 scene distribution ("split") kwargs. The bare-groot gym id
+    # (robocasa_{alias}/{task}_{class}_Env) goes through RoboCasaEnv ->
+    # create_env_robosuite, which — unlike the native-eval env (robocasa/{task}
+    # -> RoboCasaGymEnv -> create_env(split=...)) — receives NO split and thus
+    # falls back to obj_instance_split="pretrain" + layout_and_style_ids=
+    # [[1,1],[2,2],[4,4],[6,9],[7,10]]. RLDX-1's SFT ckpt was trained on the
+    # `target` split (datasets/v1.0/target/composite/*) and native eval
+    # ran with --robocasa_split target => 43.6%; the pretrain fallback is
+    # an out-of-distribution scene set that ~halves rollout SR. These mirror
+    # robocasa.utils.env_utils.create_env's `split=="target"` branch exactly and
+    # ride the __init__ **kwargs passthrough (GrootRoboCasaEnv -> RoboCasaEnv ->
+    # create_env_robosuite) straight to robosuite.make, overriding the defaults.
+    #
+    # GATED on the (default-absent) cfg flag `rldx_robocasa_split`. GR00T
+    # configs never set it, so no split kwargs are passed and the GR00T
+    # train/eval path (gym.make with no scene kwargs) is byte-for-byte identical.
+    @staticmethod
+    def _split_scene_kwargs(split):
+        if split == "target":
+            return {
+                "obj_instance_split": "target",
+                "layout_ids": None,
+                "style_ids": None,
+                "layout_and_style_ids": list(zip(range(1, 11), range(1, 11))),
+            }
+        if split == "pretrain":
+            return {
+                "obj_instance_split": "pretrain",
+                "layout_ids": -2,
+                "style_ids": -2,
+                "layout_and_style_ids": None,
+            }
+        if split == "all":
+            return {
+                "obj_instance_split": None,
+                "layout_ids": -3,
+                "style_ids": -3,
+                "layout_and_style_ids": None,
+            }
+        raise ValueError(
+            f'rldx_robocasa_split must be one of {{target, pretrain, all}}, got {split!r}'
+        )
+
+    def get_env_fns(self):
+        env_fns = []
+        robot_alias = self.cfg.get("robot_alias", "panda_omron")
+        split = self.cfg.get("rldx_robocasa_split", None)
+        scene_kwargs = self._split_scene_kwargs(split) if split is not None else {}
+        for env_id in range(self.num_envs):
+            task_name = self.task_names[self.task_ids[env_id]]
+            env_seed = int(self.env_seeds[env_id])
+            env_class = self.cfg.get("env_class_suffix", "PandaOmron")
+            env_gym_id = f"robocasa_{robot_alias}/{task_name}_{env_class}_Env"
+
+            def env_fn(env_gym_id=env_gym_id, seed=env_seed, scene_kwargs=scene_kwargs):
+                import robocasa.utils.gym_utils.gymnasium_groot  # noqa: F401
+
+                env = gym.make(env_gym_id, disable_env_checker=True, **scene_kwargs)
+                env = env.unwrapped
+                env.reset(seed=seed)
+                return _ActionDictAdapter(env)
+
+            env_fns.append(env_fn)
+        return env_fns
+
+    def _extract_image_and_state(self, obs):
+        """Re-flatten GrootRoboCasaEnv GR00T-format dict obs into arrays.
+
+        Images are already vertically flipped and resized to 256x256 by
+        GrootRoboCasaEnv.get_basic_observation/process_img — DO NOT flip again.
+        """
+        main_images, extra_images, wrist_images, states = [], [], [], []
+
+        for env_id in range(len(obs)):
+            o = obs[env_id]
+            main_images.append(o[GROOT_IMAGE_KEY_MAPPING["main_images"]])
+            extra_images.append(o[GROOT_IMAGE_KEY_MAPPING["extra_view_images"]])
+            wrist_images.append(o[GROOT_IMAGE_KEY_MAPPING["wrist_images"]])
+
+            parts = [
+                np.asarray(o[key], dtype=np.float32).reshape(-1)[:dim]
+                for key, dim in GROOT_STATE_KEYS
+            ]
+            states.append(np.concatenate(parts, axis=-1))
+
+        return {
+            "main_images": np.array(main_images),
+            "extra_view_images": np.array(extra_images),
+            "wrist_images": np.array(wrist_images),
+            "state": np.array(states, dtype=np.float32),
+        }
+
+    def _extract_task_description(self, obs_list):
+        return [
+            o.get("annotation.human.action.task_description", "") for o in obs_list
+        ]
+
+    # ---------------------------------------------------------------- frame stack
+    # RLDX-1's SFT ckpt consumes a MULTI-FRAME temporal video stack per camera
+    # (video delta_indices = [-6,-4,-2,0], i.e. 4 frames at env-step stride 2),
+    # whereas GR00T is single-frame (delta_indices=[0]). The shared RoboCasa365
+    # env otherwise hands the model only the latest frame, which is an
+    # out-of-distribution obs for RLDX-1 and roughly halves its rollout SR.
+    #
+    # This override re-creates the exact stack RLDX-1's native MultiStepWrapper
+    # feeds. That wrapper keeps a deque(maxlen = max|delta|+1 = 7) and, after
+    # running the chunk, returns obs[i] for i in (delta_indices - 1) =
+    # [-7,-5,-3,-1]. Because the RL chunk length (num_action_chunks=16) is
+    # LARGER than that deque, every stacked frame is guaranteed to live inside
+    # the current chunk's own obs_list -- no cross-chunk history is ever needed
+    # (this is why we don't carry a per-env buffer or pad at chunk boundaries).
+    # `chunk_step`'s obs_list already holds all 16 per-env-step observations.
+    #
+    # GATED on the (default-absent) env cfg flag `rldx_frame_stack`. GR00T
+    # configs never set it, so `super().chunk_step` returns unchanged and the
+    # GR00T train/eval path is byte-for-byte identical.
+    _STACK_KEYS = ("main_images", "extra_view_images", "wrist_images")
+
+    def chunk_step(self, chunk_actions):
+        result = super().chunk_step(chunk_actions)
+        if not bool(self.cfg.get("rldx_frame_stack", False)):
+            return result
+
+        obs_list, chunk_rewards, chunk_terminations, chunk_truncations, infos_list = (
+            result
+        )
+        if not isinstance(obs_list, (list, tuple)) or len(obs_list) == 0:
+            return result
+
+        delta = list(
+            self.cfg.get("rldx_frame_stack_delta", [-6, -4, -2, 0])
+        )
+        chunk_len = len(obs_list)
+        # native takes obs[i] for i in (delta - 1); obs_list[-1] is the latest
+        # post-action frame. Clamp so a too-deep delta falls back to the oldest
+        # frame available in this chunk (never indexes past obs_list[0]).
+        stack_idx = [max(d - 1, -chunk_len) for d in delta]
+
+        # Envs that hit done THIS chunk were auto-reset: obs_list[-1] is the new
+        # episode's fresh reset frame. Native re-pads its deque with that frame,
+        # so the stack for those envs must be [reset_frame] * T (NOT a mix of
+        # old-episode frames). Under auto_reset the past done flags are folded
+        # into the last chunk slot (see RobocasaEnv.chunk_step).
+        past_dones = None
+        if bool(self.auto_reset):
+            term_last = chunk_terminations[:, -1]
+            trunc_last = chunk_truncations[:, -1]
+            past_dones = torch.logical_or(term_last, trunc_last)
+
+        last_obs = obs_list[-1]
+        for cam in self._STACK_KEYS:
+            if cam not in last_obs:
+                continue
+            frames = [obs_list[i][cam] for i in stack_idx]  # each [B,H,W,C]
+            stacked = torch.stack(frames, dim=1)  # [B, T, H, W, C]
+            if past_dones is not None and bool(past_dones.any()):
+                # overwrite reset envs with reset_frame repeated over T
+                reset_frame = last_obs[cam]  # [B,H,W,C]
+                T = stacked.shape[1]
+                reset_stack = reset_frame.unsqueeze(1).expand(-1, T, *([-1] * (reset_frame.dim() - 1)))
+                mask = past_dones.to(stacked.device).view(-1, *([1] * (stacked.dim() - 1)))
+                stacked = torch.where(mask, reset_stack, stacked)
+            last_obs[f"stacked_{cam}"] = stacked
+
+        return obs_list, chunk_rewards, chunk_terminations, chunk_truncations, infos_list
+
+    def _wrap_obs(self, obs_list, info_list):
+        extracted = self._extract_image_and_state(obs_list)
+        # Task description lives in the obs dict, not info, for GrootRoboCasaEnv.
+        task_descriptions = self._extract_task_description(obs_list)
+
+        per_env = []
+        for idx in range(self.num_envs):
+            per_env.append(
+                {
+                    "main_images": extracted["main_images"][idx],
+                    "extra_view_images": extracted["extra_view_images"][idx],
+                    "wrist_images": extracted["wrist_images"][idx],
+                    "state": extracted["state"][idx],
+                }
+            )
+        tensors = to_tensor(list_of_dict_to_dict_of_list(per_env))
+
+        obs = {
+            "states": tensors["state"],
+            "task_descriptions": task_descriptions,
+        }
+        for flat_key in ("main_images", "extra_view_images", "wrist_images"):
+            obs[flat_key] = torch.stack(
+                [v.clone() for v in tensors[flat_key]]
+            )
+        return obs
