+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""RLDX-1 RL policy adapter for RLinf.
+
+Wraps a native RLDX-1 model (backbone + MSAT action_model) plus its native
+RLDXProcessor (obs->tokens, action decode) and adds the flow-matching RL head
+(SDE logprob + value head). Implements the RLinf ``BasePolicy`` interface so the
+existing FSDP actor / HF rollout workers drive it exactly like GR00T.
+
+Design = composition, not subclassing RLDX: RLDX carries memory/physics/RTC
+branches irrelevant to this ckpt (all disabled), so we hold a reference and reuse
+only its backbone + ``action_model._encode_features`` (vlln + state encoder) +
+MSAT. RL sampling/logprob/value live in ``RLDX1RLHead`` (verified on the real
+ckpt: p1b/p2/p3 in RLDX-1/notes).
+
+IO is delegated to RLDX-1's native pipeline:
+  obs  : RLinf flat env_obs -> nested (simulation_io) -> per-sample VLAStepData
+         -> processor(...) -> collator -> collated model inputs
+  action: model action_pred -> processor.decode_action (unnorm + rel->abs)
+         -> flatten to 12-D RoboCasa365 action (simulation_io)
+"""
+
+from typing import Any, Literal
+
+import numpy as np
+import torch
+import torch.nn as nn
+
+from rlinf.models.embodiment.base_policy import BasePolicy, ForwardType
+from rlinf.models.embodiment.rldx1.rldx1_rl_head import RLDX1RLHead
+from rlinf.models.embodiment.rldx1.simulation_io import (
+    convert_robocasa365_obs_to_rldx_nested,
+    flatten_rldx_action,
+)
+
+
+class RLDX1_ForRLActionPrediction(nn.Module, BasePolicy):
+    """RLDX-1 policy for RL. Holds the native model + processor + RL head."""
+
+    # FSDP per-layer wrap targets (auto path in get_fsdp_wrap_policy reads this
+    # off the module since the adapter has no `.language_model` attr). Without it
+    # the 6.9B backbone is wrapped as one flat unit -> every rank holds all params
+    # -> OOM. Sharded at layer granularity:
+    #   Qwen3VLTextDecoderLayer / Qwen3VLVisionBlock : VTCQwen3VL backbone
+    #   DoubleStreamBlock (x4) / SingleStreamBlock (x8) : MSAT (use_physics=False,
+    #     so plain, not Expanded* blocks; depths from ckpt diffusion_model_cfg)
+    #   ValueHead : RL value head (present only when add_value_head=True; GRPO
+    #     turns it off, so the GRPO config overrides wrap_policy MINUS ValueHead,
+    #     mirroring the GR00T GRPO config).
+    _no_split_modules = [
+        "Qwen3VLTextDecoderLayer",
+        "Qwen3VLVisionBlock",
+        "DoubleStreamBlock",
+        "SingleStreamBlock",
+        "ValueHead",
+    ]
+
+    def __init__(
+        self,
+        rldx_model,           # native RLDX (PreTrainedModel)
+        processor,            # native RLDXProcessor (obs/action IO)
+        rl_head_config: dict[str, Any],
+        embodiment_tag,       # EmbodimentTag enum
+        output_action_chunks: int = 16,
+        compute_dtype: torch.dtype = torch.bfloat16,
+    ):
+        super().__init__()
+        self.model = rldx_model
+        self.processor = processor
+        self.embodiment_tag = embodiment_tag
+        self.output_action_chunks = output_action_chunks
+        self.compute_dtype = compute_dtype
+        self.rl_config = rl_head_config
+
+        am = self.model.action_model
+        backbone_dim = self.model.config.backbone_embedding_dim
+        state_dim = am.input_embedding_dim
+        self.rl_head = RLDX1RLHead(rl_head_config, backbone_dim=backbone_dim, state_dim=state_dim)
+
+        # Real (unpadded) action dim for RL slicing. RLDX pads actions to
+        # max_action_dim (64); logprob/loss must only cover the valid dims
+        # (RoboCasa365 = 3+3+1+4+1 = 12), mirroring GR00T's valid_action_dim.
+        self.valid_action_dim = self._compute_valid_action_dim()
+
+        # language key used by the native pipeline
+        self._language_key = "annotation.human.task_description"
+
+    def _compute_valid_action_dim(self) -> int:
+        emb = self.embodiment_tag.value
+        norm = self.processor.state_action_processor.norm_params[emb]["action"]
+        keys = self.processor.modality_configs[emb]["action"].modality_keys
+        return int(sum(norm[k]["dim"].item() for k in keys))
+
+    # ---- convenience passthroughs (worker may probe these) ----
+    @property
+    def value_head(self):
+        return self.rl_head.value_head if self.rl_head.add_value_head else None
+
+    def set_global_step(self, step: int):
+        self.rl_head.global_step = int(step)
+
+    def gradient_checkpointing_enable(self, gradient_checkpointing_kwargs=None):
+        """Delegate GC to the native RLDX model (a PreTrainedModel with
+        supports_gradient_checkpointing=True). HF propagates it recursively to the
+        backbone Qwen3VLTextDecoderLayers and MSAT stream blocks. The FSDP manager
+        calls this with no args (use_reentrant=True) or with
+        gradient_checkpointing_kwargs (use_reentrant=False); mirror both."""
+        if gradient_checkpointing_kwargs is None:
+            self.model.gradient_checkpointing_enable()
+        else:
+            self.model.gradient_checkpointing_enable(
+                gradient_checkpointing_kwargs=gradient_checkpointing_kwargs
+            )
+
+    def gradient_checkpointing_disable(self):
+        self.model.gradient_checkpointing_disable()
+
+    @property
+    def device(self):
+        return next(self.parameters()).device
+
+    @property
+    def dtype(self):
+        return self.compute_dtype
+
+    # =========================================================== obs -> model
+    def _obs_to_collated(self, env_obs: dict[str, Any]) -> dict[str, Any]:
+        """RLinf flat env_obs -> collated model inputs via native processor."""
+        from rldx.data.types import VLAStepData
+
+        nested = convert_robocasa365_obs_to_rldx_nested(env_obs)
+        bsize = nested["video"]["robot0_agentview_left"].shape[0]
+
+        processed = []
+        states = []
+        for i in range(bsize):
+            per = {
+                "video": {k: v[i] for k, v in nested["video"].items()},
+                "state": {k: v[i] for k, v in nested["state"].items()},
+                "language": {k: v[i] for k, v in nested["language"].items()},
+            }
+            vla = VLAStepData(
+                images=per["video"],
+                states=per["state"],
+                actions={},
+                text=per["language"][self._language_key][0],
+                embodiment=self.embodiment_tag,
+                physics={},
+            )
+            states.append(vla.states)
+            processed.append(self.processor([{"type": "episode_step", "content": vla}]))
+
+        collated = self.processor.collator(processed)
+        collated = collated["inputs"] if "inputs" in collated else collated
+        # move to device + bf16 for floats (mirror RLDX prepare_input)
+        collated = self._to_device_dtype(collated)
+        return collated, states
+
+    def _to_device_dtype(self, batch):
+        def _map(x):
+            if not torch.is_tensor(x):
+                return x
+            if torch.is_floating_point(x):
+                return x.to(self.device, dtype=self.compute_dtype)
+            return x.to(self.device)
+
+        if isinstance(batch, dict):
+            return {k: self._to_device_dtype(v) for k, v in batch.items()}
+        return _map(batch)
+
+    def _backbone_encode(self, collated):
+        """Frozen backbone forward -> RAW features safe to cache in
+        forward_inputs. Returns:
+          raw_vl       [B, 64, 4096] : the 64 cog tokens, PRE-vlln (backbone is
+                                       frozen -> constant given the obs).
+          state        [B, 1, 64]    : raw proprio state (action_input.state).
+          embodiment_id[B]           : embodiment ids.
+          vl_attn_mask               : None (cog tokens carry no padding; the
+                                       backbone emits an all-True [B,64] mask).
+        vlln + state_encoder are NOT applied here -- they live in the trainable
+        action_model, so applying them at the cache boundary would sever their
+        gradients. They are re-applied on the actor side (_project_features)."""
+        backbone_inputs, action_inputs = self.model.prepare_input(dict(collated))
+        backbone_outputs = self.model.backbone(backbone_inputs)
+        raw_vl = backbone_outputs["backbone_features"]   # [B, 64, 4096] pre-vlln
+        state = action_inputs.state                       # [B, 1, 64]
+        embodiment_id = action_inputs.embodiment_id       # [B]
+        vl_attn_mask = backbone_outputs.get("backbone_attention_mask", None)
+        if vl_attn_mask is not None and vl_attn_mask.all():
+            vl_attn_mask = None
+        return raw_vl, state, embodiment_id, vl_attn_mask
+
+    def _project_features(self, raw_vl, state, embodiment_id):
+        """Apply the TRAINABLE vlln + state_encoder (both in action_model) to the
+        frozen backbone outputs -> (vl_embs [B,64,4096], state_features
+        [B,1,1536]). Gradients flow into vlln + state_encoder + (downstream) MSAT
+        + value head; the frozen 8B backbone is skipped entirely on the actor
+        side (its output was cached during rollout)."""
+        am = self.model.action_model
+        vl_embs = am.vlln(raw_vl)
+        state_features = am.state_encoder(state, embodiment_id)
+        return vl_embs, state_features
+
+    # =========================================================== BasePolicy
+    def forward(self, forward_type=ForwardType.DEFAULT, **kwargs):
+        if forward_type == ForwardType.DEFAULT:
+            return self.default_forward(**kwargs)
+        raise NotImplementedError(f"forward_type {forward_type} not supported for RLDX-1")
+
+    def default_forward(
+        self,
+        forward_inputs: dict[str, torch.Tensor],
+        compute_logprobs: bool = True,
+        compute_entropy: bool = False,
+        compute_values: bool = True,
+        use_cache: bool = False,
+        **kwargs,
+    ) -> dict[str, Any]:
+        """Actor recompute: re-project the CACHED frozen-backbone features
+        (raw cog tokens + raw state) through the trainable vlln + state_encoder,
+        then recompute logprob/value on the stored chains/denoise_inds. The 8B
+        backbone is NOT re-run (frozen -> its rollout output is exact); gradients
+        still flow into vlln + state_encoder + MSAT + value head. Returns logprobs
+        aligned to the sampled step."""
+        raw_vl = forward_inputs["raw_vl"]
+        state = forward_inputs["state"]
+        embodiment_id = forward_inputs["embodiment_id"]
+        vl_embs, state_features = self._project_features(raw_vl, state, embodiment_id)
+        vl_attn_mask = None  # cog tokens are unpadded (all-True mask -> None)
+        chains = forward_inputs["chains"]
+        denoise_inds = forward_inputs["denoise_inds"]
+
+        am = self.model.action_model
+        log_probs, values = self.rl_head.recompute_logprob_value(
+            am, vl_embs, state_features, embodiment_id, chains, denoise_inds,
+            vl_attn_mask=vl_attn_mask, compute_values=compute_values,
+        )
+
+        # slice to valid action chunk/dim (unpadded: RoboCasa365 = 12, not the
+        # 64-dim MSAT padding), mirroring GR00T's valid_action_dim slicing.
+        chunk = self.output_action_chunks
+        vdim = self.valid_action_dim
+        log_probs = log_probs[:, :chunk, :vdim]
+
+        # prev_logprobs (from rollout) at the sampled step, same slicing
+        bsize = log_probs.shape[0]
+        prev_logprobs = kwargs["prev_logprobs"]
+        prev_logprobs = prev_logprobs[
+            torch.arange(bsize, device=prev_logprobs.device),
+            denoise_inds[:, 0],
+            :chunk,
+            :vdim,
+        ]
+        values = values.mean(dim=-1)
+
+        return {
+            "logprobs": log_probs.float(),
+            "prev_logprobs": prev_logprobs.float(),
+            "values": values,
+            "entropy": None,
+        }
+
+    @torch.no_grad()
+    def predict_action_batch(
+        self,
+        env_obs,
+        mode: Literal["train", "eval"] = "train",
+        **kwargs,
+    ) -> tuple[torch.Tensor, dict[str, Any]]:
+        """Rollout: obs -> collated -> frozen backbone -> RL-head sample -> decode
+        action. Returns (raw_action[B,chunk,12], result dict for actor recompute).
+
+        forward_inputs caches the FROZEN backbone output (raw cog tokens + raw
+        state + embodiment_id), all batch-first fixed-shape tensors, NOT the raw
+        Qwen3-VL collated dict (whose pixel_values/image_grid_thw have dim0 = total
+        patches, not env count -> breaks _split_rollout_result's dim0 split; and
+        input_ids padding corrupts the cog tokens via MRoPE, maxdiff 8.0). The
+        trainable vlln + state_encoder are re-applied on the actor side."""
+        collated, states = self._obs_to_collated(env_obs)
+        raw_vl, state, embodiment_id, vl_attn_mask = self._backbone_encode(collated)
+        vl_embs, state_features = self._project_features(raw_vl, state, embodiment_id)
+
+        am = self.model.action_model
+        x0, res = self.rl_head.get_rl_action(
+            am, vl_embs, state_features, embodiment_id,
+            vl_attn_mask=vl_attn_mask, mode=mode,
+            compute_values=self.rl_head.add_value_head,
+        )
+
+        # decode action via native processor (unnorm + rel->abs)
+        normalized_action = x0.float().cpu().numpy()
+        batched_states = np.stack([s for s in states], axis=0) if len(states) else None
+        action_group = self.processor.decode_action(
+            normalized_action, self.embodiment_tag, state=batched_states
+        )
+        raw_action = flatten_rldx_action(action_group, chunk_size=self.output_action_chunks)
+
+        # Cache ONLY batch-first fixed-shape tensors (dim0 == num_envs) so
+        # _split_rollout_result's torch.split(..., dim=0) and the actor's
+        # per-env masking are valid. state keeps its [B,1,64] shape; embodiment_id
+        # is [B]. squeeze not needed -- dim0 is already the env axis.
+        forward_inputs = {
+            "chains": res["chains"],
+            "denoise_inds": res["denoise_inds"],
+            "raw_vl": raw_vl,
+            "state": state,
+            "embodiment_id": embodiment_id,
+        }
+        result = {
+            "prev_logprobs": res["prev_logprobs"],
+            "prev_values": res["prev_values"],
+            "forward_inputs": forward_inputs,
+        }
+        return torch.from_numpy(raw_action), result
