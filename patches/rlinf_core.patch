+"""OpenPi data config for RoboCasa365 (RC365).
+
+Mirrors the SFT-time data pipeline (openpi-robocasa) so RL is consistent with
+finetuning: 16-D state, 3 camera views, 12-D action. Unlike the old-robocasa
+``LeRobotRobocasaDataConfig`` (which slices via ``rlinf.envs.robocasa.utils``
+for 25-D/2-view), RC365 uses the simple pad/slice transform in
+``robocasa365_policy`` and does NOT depend on the old robocasa env utils.
+"""
+import dataclasses
+import pathlib
+
+import openpi.models.model as _model
+import openpi.transforms as _transforms
+from openpi.training.config import DataConfig, DataConfigFactory, ModelTransformFactory
+from typing_extensions import override
+
+from rlinf.models.embodiment.openpi.policies import robocasa365_policy
+
+
+@dataclasses.dataclass(frozen=True)
+class LeRobotRobocasa365DataConfig(DataConfigFactory):
+    """Data config for RoboCasa365 (16-D state, 3 views, 12-D action)."""
+
+    @override
+    def create(
+        self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig
+    ) -> DataConfig:
+        # RLinf uses an empty repack transform at RL time (see
+        # rlinf/models/embodiment/openpi/__init__.py); the env obs_processor
+        # already emits the observation/* keys the input transform expects.
+        repack_transform = _transforms.Group()
+
+        data_transforms = _transforms.Group(
+            inputs=[
+                robocasa365_policy.Robocasa365Inputs(
+                    action_dim=model_config.action_dim,
+                    model_type=model_config.model_type,
+                )
+            ],
+            outputs=[robocasa365_policy.Robocasa365Outputs()],
+        )
+
+        # Model transforms (tokenize prompt, pack action targets). No changes needed.
+        model_transforms = ModelTransformFactory()(model_config)
+
+        # SFT alignment (CRITICAL): the RC365 pi05 SFT ran with mean/std
+        # normalization (use_quantile_norm=False) — its norm_stats therefore
+        # carry null q01/q99. This RLinf openpi build's create_base_config
+        # instead defaults pi05 to use_quantile_norm=True (model_type != PI0),
+        # so Normalize would assert on the missing quantiles and RL would apply
+        # a normalization the policy never saw. Force it back to False to match
+        # the SFT data pipeline exactly (verified against the SFT TrainConfig
+        # pi05_robocasa_finetune_target_composite_seen, which resolves to False).
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+            use_quantile_norm=False,
+        )
