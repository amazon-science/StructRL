+"""OpenPi input/output transforms for RoboCasa365 (RC365).
+
+This mirrors the SFT-time transform used to finetune pi0/pi05 on RC365
+(see openpi-robocasa/src/openpi/policies/robocasa_policy.py) so that the
+RL-time observation pipeline is byte-for-byte consistent with training:
+
+  * state: 16-D RC365 proprio (eef_pos_rel 3 + eef_rot_rel quat 4 +
+    gripper_qpos 2 + base_pos 3 + base_rot quat 4), padded to the model
+    action_dim (32).
+  * images: 3 raw camera views (base / left wrist / right = extra view).
+    - pi0  : right view padded with zeros and masked out.
+    - pi05 : all 3 views used, right view required.
+  * actions: 12-D RC365 action, padded to model action_dim; output slices
+    the first 12 dims back out.
+
+The only difference vs the SFT transform is the key that carries the third
+camera: the RL env's obs_processor emits ``observation/extra_view_image``
+whereas the SFT dataset script used ``observation/right_image``. Both are
+accepted here.
+"""
+import dataclasses
+
+import einops
+import numpy as np
+from openpi import transforms
+from openpi.models import model as _model
+
+
+# RC365 real dims: state is 16-D, action is 12-D. Do not change for RC365.
+ROBOCASA365_STATE_DIM = 16
+ROBOCASA365_ACTION_DIM = 12
+
+
+def make_robocasa365_example() -> dict:
+    """Creates a random input example for the RoboCasa365 policy."""
+    return {
+        "observation/state": np.random.rand(ROBOCASA365_STATE_DIM),
+        "observation/image": np.random.randint(
+            256, size=(224, 224, 3), dtype=np.uint8
+        ),
+        "observation/wrist_image": np.random.randint(
+            256, size=(224, 224, 3), dtype=np.uint8
+        ),
+        "observation/extra_view_image": np.random.randint(
+            256, size=(224, 224, 3), dtype=np.uint8
+        ),
+        "prompt": "do something",
+    }
+
+
+def _parse_image(image) -> np.ndarray:
+    image = np.asarray(image)
+    if np.issubdtype(image.dtype, np.floating):
+        image = (255 * image).astype(np.uint8)
+    if image.shape[0] == 3:
+        image = einops.rearrange(image, "c h w -> h w c")
+    return image
+
+
+def _get_extra_view(data: dict):
+    """Third camera view: RL emits extra_view_image, SFT used right_image."""
+    if "observation/extra_view_image" in data:
+        return data["observation/extra_view_image"]
+    if "observation/right_image" in data:
+        return data["observation/right_image"]
+    return None
+
+
+@dataclasses.dataclass(frozen=True)
+class Robocasa365Inputs(transforms.DataTransformFn):
+    """Convert RC365 env/dataset observations into the pi0/pi05 model format."""
+
+    # The action dimension of the model. Used to pad state and actions.
+    action_dim: int
+
+    # Determines which model (pi0 vs pi05) will be used.
+    model_type: _model.ModelType = _model.ModelType.PI0
+
+    def __call__(self, data: dict) -> dict:
+        mask_padding = self.model_type == _model.ModelType.PI0
+
+        # Pad the 16-D proprio to the model action dimension.
+        state = transforms.pad_to_dim(data["observation/state"], self.action_dim)
+
+        base_image = _parse_image(data["observation/image"])
+        wrist_image = _parse_image(data["observation/wrist_image"])
+
+        # For pi05, use all 3 cameras (right view required). For pi0, the right
+        # view is padded with zeros and masked out.
+        if self.model_type == _model.ModelType.PI05:
+            extra = _get_extra_view(data)
+            if extra is None:
+                raise ValueError(
+                    "RC365 pi05 requires a third camera view "
+                    "(observation/extra_view_image or observation/right_image), "
+                    "but none was found in data."
+                )
+            right_image = _parse_image(extra)
+            right_mask = np.True_
+        else:
+            # pi0 was SFT'd with the third view zeroed + masked out. Match that
+            # exactly at RL time to avoid a train/inference distribution shift,
+            # regardless of whether the env provides a third view.
+            right_image = np.zeros_like(base_image)
+            right_mask = np.False_ if mask_padding else np.True_
+
+        inputs = {
+            "state": state,
+            "image": {
+                "base_0_rgb": base_image,
+                "left_wrist_0_rgb": wrist_image,
+                "right_wrist_0_rgb": right_image,
+            },
+            "image_mask": {
+                "base_0_rgb": np.True_,
+                "left_wrist_0_rgb": np.True_,
+                "right_wrist_0_rgb": right_mask,
+            },
+        }
+
+        # Actions only available during training; pad 12-D to model action_dim.
+        if "actions" in data:
+            actions = transforms.pad_to_dim(data["actions"], self.action_dim)
+            inputs["actions"] = actions
+
+        if "prompt" in data:
+            inputs["prompt"] = data["prompt"]
+
+        return inputs
+
+
+@dataclasses.dataclass(frozen=True)
+class Robocasa365Outputs(transforms.DataTransformFn):
+    """Convert model outputs back to the RC365 12-D action format (inference)."""
+
+    def __call__(self, data: dict) -> dict:
+        # Return only the first 12 (real RC365) action dims; the rest is padding.
+        return {"actions": np.asarray(data["actions"][:, :ROBOCASA365_ACTION_DIM])}
