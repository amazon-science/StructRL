+def _key_padding_to_additive(mask_2d, q_len, dtype):
+    """Convert a (B, kv) key-padding mask (1=keep, 0=pad) into an additive
+    attention bias of shape (B, 1, q_len, kv): 0.0 on kept keys, -inf on pad
+    keys. diffusers `Attention` adds this to the attention scores before
+    softmax, so padded key positions get zero weight."""
+    if mask_2d is None:
+        return None
+    B, kv = mask_2d.shape
+    neg = torch.finfo(dtype).min
+    add = torch.zeros(B, 1, q_len, kv, dtype=dtype, device=mask_2d.device)
+    pad_cols = (mask_2d == 0)[:, None, None, :]  # (B, 1, 1, kv)
+    return add.masked_fill(pad_cols, neg)
+
