diff --git a/src/openpi/training/_robocasa_static_registry.py b/src/openpi/training/_robocasa_static_registry.py
new file mode 100644
index 0000000..3dc6266
--- /dev/null
+++ b/src/openpi/training/_robocasa_static_registry.py
@@ -0,0 +1,42 @@
+"""Offline-exported RoboCasa365 dataset registry.
+
+This shim exists so the ISOLATED openpi (JAX) training venv does NOT need to
+import the `robocasa` package (which pulls robosuite -> mujoco, the full sim
+stack) just to resolve dataset paths.
+
+The data below was exported once from a robocasa-enabled venv via:
+    DATASET_SOUP_REGISTRY[key]  and  get_ds_meta(...)
+with macros.DATASET_BASE_PATH = datasets
+(the model-training-relevant entries were verified to exist on disk).
+
+It exposes the same three symbols config.py imported from robocasa:
+    DATASET_BASE_PATH, DATASET_SOUP_REGISTRY, get_ds_meta
+"""
+
+import json as _json
+import os as _os
+
+_HERE = _os.path.dirname(_os.path.abspath(__file__))
+_DATA_PATH = _os.path.join(_HERE, "_robocasa_static_registry.json")
+
+with open(_DATA_PATH) as _f:
+    _DATA = _json.load(_f)
+
+DATASET_BASE_PATH = _DATA["DATASET_BASE_PATH"]
+DATASET_SOUP_REGISTRY = _DATA["registry"]
+_DS_META = _DATA["ds_meta"]
+
+
+def get_ds_meta(task, split, source, demo_fraction=1.0):
+    """Static lookup mirroring robocasa.utils.dataset_registry.get_ds_meta.
+
+    Only the (task, split, source) combinations actually used by config.py were
+    exported. demo_fraction=1.0 is the only value openpi configs use.
+    """
+    key = f"{task}|{split}|{source}"
+    if key not in _DS_META:
+        raise KeyError(
+            f"get_ds_meta({task!r}, {split!r}, {source!r}) not in static export. "
+            f"Re-export from a robocasa-enabled venv if a new config needs it."
+        )
+    return _DS_META[key]
